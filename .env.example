# Local development needs no Google account or service-account key.
FIREBASE_MODE=emulator
FIREBASE_PROJECT_ID=demo-eden-salon
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
API_PORT=4100
WEB_ORIGIN=http://127.0.0.1:3100,http://localhost:3100
EDEN_API_ORIGIN=http://127.0.0.1:4100

# These credentials are for the loopback-only demo, never a live salon.
ADMIN_EMAIL=owner@eden.demo
ADMIN_PASSWORD=EdenDemo2026!

# Cloud setup: FIREBASE_MODE=cloud; remove FIRESTORE_EMULATOR_HOST.
# FIREBASE_PROJECT_ID=your-real-project
# Keyless local authorization: install Google Cloud CLI, then run
# gcloud auth application-default login
# Complete the Google sign-in yourself with an account allowed to use this project.
# Leave GOOGLE_APPLICATION_CREDENTIALS and FIREBASE_SERVICE_ACCOUNT_JSON unset
# to use the local ADC identity. Firebase console sign-in alone is not ADC.
# Cloud requires HTTPS WEB_ORIGIN and strong secrets, with the explicit
# loopback preview exception below.
# Optional explicit credential file (not required for keyless ADC):
# GOOGLE_APPLICATION_CREDENTIALS=absolute-path-to-private-credential.json
# ADMIN_EMAIL=your-admin-email
# ADMIN_PASSWORD=unique-password-at-least-12-characters
# ADMIN_JWT_SECRET=unique-random-secret-at-least-32-characters
# MANAGE_TOKEN_SECRET=different-random-secret-at-least-32-characters
# WEB_ORIGIN=https://your-domain

# Optional real-cloud database with a loopback-only local browser preview:
# FIREBASE_MODE=cloud
# EDEN_LOCAL_PREVIEW=true
# WEB_ORIGIN=http://127.0.0.1:3100,http://localhost:3100
# Leave FIRESTORE_EMULATOR_HOST unset. The API stays bound to 127.0.0.1.
# Every origin must be exactly one of those literal HTTP loopback hosts with
# a valid port. No network hosts, aliases, paths, queries, or fragments.
# Admin cookies remain HttpOnly/SameSite=Strict; Secure is disabled only for
# this explicit loopback preview. Unique password/secrets remain required.
# This option never enables cloud seeding or emulator demo credentials.
