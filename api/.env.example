# The runner sets these defaults for a safe local Firestore demonstration.
FIREBASE_MODE=emulator
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_PROJECT_ID=demo-eden-salon
API_PORT=4100
WEB_ORIGIN=http://127.0.0.1:3100,http://localhost:3100

# Demo-only credentials are built in. Override for a local custom demo if desired.
# ADMIN_EMAIL=owner@eden.demo
# ADMIN_PASSWORD=EdenDemo2026!

# Cloud configuration (set process environment; do not commit secrets):
# FIREBASE_MODE=cloud
# Unset FIRESTORE_EMULATOR_HOST in cloud mode.
# FIREBASE_PROJECT_ID=your-real-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/service-account.json
# Alternatively set FIREBASE_SERVICE_ACCOUNT_JSON to a service-account JSON value.
# WEB_ORIGIN=https://your-salon-site.example
# ADMIN_EMAIL=your-owner-email
# ADMIN_PASSWORD=unique-password-at-least-12-characters
# ADMIN_JWT_SECRET=unique-random-secret-at-least-32-characters
# MANAGE_TOKEN_SECRET=different-random-secret-at-least-32-characters
